// @see - https://www.electron.build/configuration/configuration
{
	$schema: 'https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json',
	appId: 'com.snowTools.app',
	asar: true,
	productName: 'SnowTools',
	directories: {
		output: 'release/${version}',
	},
	files: ['dist', 'dist-electron', 'public/**/*'],
	extraResources: [
		{
			from: 'electron/modules/nsevent-listener/build/Release',
			to: 'electron/modules/nsevent-listener/build/Release',
			filter: ['**/*'],
		},
		// 添加图标资源
		{
			from: 'public/tray-icon-mac.png',
			to: 'tray-icon-mac.png', // 直接放在 Resources 根目录
		},
		{
			from: 'public/tray-icon-win.png',
			to: 'resources/tray-icon-win.png',
		},
		{
			from: 'public',
			to: 'public', // 保持相同结构
			filter: ['**/*'],
		},
	],
	mac: {
		icon: 'public/logo.png',
		target: ['dmg'],
		artifactName: '${productName}-Mac-${version}-Installer.${ext}',
		// TCC 的授权记录会把签名证书的 subject.CN 写进 code requirement，换一张证书重签后
		// 旧记录永远匹配不上，屏幕录制就会陷入「设置里已勾选、系统仍然拒绝」的死循环。
		// 不指定时 electron-builder 会从钥匙串里自动挑一张，所以这里必须钉死。
		identity: 'Apple Development: yesihaojimmy@gmail.com (T3DM878SDC)',
		// macOS 特定配置
		extendInfo: {
			LSUIElement: false, // 确保应用显示在 Dock 和菜单栏
			NSStatusBarVisible: true, // 确保状态栏图标可见
		},
		extraResources: [
			{
				from: 'public/tray-icon-mac.png',
				to: '.',
			},
		],
	},
	win: {
		icon: 'public/logo.png',
		target: [
			{
				target: 'nsis',
				arch: ['x64'],
			},
		],
		artifactName: '${productName}-Windows-${version}-Setup.${ext}',
		// 添加 Windows 特定配置
		extraResources: [
			{
				from: 'public/tray-icon-win.png',
				to: '.',
			},
		],
	},
	nsis: {
		oneClick: false,
		perMachine: false,
		allowToChangeInstallationDirectory: true,
		deleteAppDataOnUninstall: false,
	},
	linux: {
		target: ['AppImage'],
		artifactName: '${productName}-Linux-${version}.${ext}',
	},
	// 证书不在钥匙串里时直接让构建失败，避免产出未签名的包（未签名同样会导致授权无法持久化）
	forceCodeSigning: true,
}
